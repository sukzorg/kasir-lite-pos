NODE_ENV=production
PORT=4000
TRUST_PROXY=true
REQUEST_BODY_LIMIT=5mb
JWT_SECRET=replace-with-minimum-32-random-characters
JWT_EXPIRES_IN=1d
CORS_ORIGIN=https://your-vercel-project.vercel.app,https://pos.yourdomain.com
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/kasir_lite_pos?sslaccept=strict
SEED_ADMIN_EMAIL=owner@yourdomain.com
SEED_ADMIN_USERNAME=owner
SEED_ADMIN_PASSWORD=replace-with-strong-seed-password
